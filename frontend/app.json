{
  "expo": {
    "name": "Etheria",
    "slug": "etheria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/etheria-icon.jpg",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/etheria-icon.jpg",
        "backgroundColor": "#0f0321"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/etheria-icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/etheria-icon.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f0321"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-asset",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
