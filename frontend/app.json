{
  "expo": {
    "name": "Etheria",
    "slug": "etheria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/etheria-icon.jpg",
    "scheme": "etheria",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/etheria-icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0f0321"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.etheriasystems.etheria",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record voice memos for your spiritual journal",
        "NSCameraUsageDescription": "Capture moments for your spiritual journey",
        "NSPhotoLibraryUsageDescription": "Save and share your oracle readings",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/etheria-icon.jpg",
        "backgroundColor": "#0f0321"
      },
      "package": "com.etheriasystems.etheria",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/etheria-icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/etheria-icon.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f0321"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-asset",
      "expo-video",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "etheria-app"
      }
    },
    "owner": "etheriasystems"
  }
}
