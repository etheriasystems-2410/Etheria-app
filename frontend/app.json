{
  "expo": {
    "name": "Etheria",
    "slug": "etheria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/etheria-icon.png",
    "scheme": "etheria",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/etheria-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0321"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.etheriasystems.etheria",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record voice memos for your spiritual journal",
        "NSCameraUsageDescription": "Capture moments for your spiritual journey",
        "NSPhotoLibraryUsageDescription": "Save and share your oracle readings",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/etheria-icon.png",
        "backgroundColor": "#0f0321"
      },
      "package": "com.etheriasystems.etheria",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/etheria-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/etheria-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f0321"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "etheriasystems",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b24fb307-103f-469c-87a8-149222352069"
      }
    }
  }
}
